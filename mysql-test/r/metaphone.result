INSTALL EXTENSION vsql_fuzzystrmatch;
# metaphone basic
SELECT vsql_fuzzystrmatch.metaphone('Robert', 10);
vsql_fuzzystrmatch.metaphone('Robert', 10)
RBRT
SELECT vsql_fuzzystrmatch.metaphone('Thompson', 10);
vsql_fuzzystrmatch.metaphone('Thompson', 10)
0MPSN
# metaphone truncation
SELECT vsql_fuzzystrmatch.metaphone('Robert', 2);
vsql_fuzzystrmatch.metaphone('Robert', 2)
RB
# metaphone NULL
SELECT vsql_fuzzystrmatch.metaphone(NULL, 10);
vsql_fuzzystrmatch.metaphone(NULL, 10)
NULL
# metaphone output longer than the server's actual initial result
# buffer (the framework rounds buffer_size(64) up to a 1024-byte
# allocation quantum, so the input must clear 1024 bytes of output
# to exercise the overflow path): the server must grow the buffer
# and retry so the full code comes back, not a truncated prefix.
SELECT LENGTH(vsql_fuzzystrmatch.metaphone('', 2000));
LENGTH(vsql_fuzzystrmatch.metaphone('BFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBF
1500
SELECT vsql_fuzzystrmatch.metaphone('', 2000);
vsql_fuzzystrmatch.metaphone('BFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFBFB

UNINSTALL EXTENSION vsql_fuzzystrmatch;
