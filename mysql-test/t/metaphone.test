INSTALL EXTENSION vsql_fuzzystrmatch;

--echo # metaphone basic
SELECT vsql_fuzzystrmatch.metaphone('Robert', 10);
SELECT vsql_fuzzystrmatch.metaphone('Thompson', 10);

--echo # metaphone truncation
SELECT vsql_fuzzystrmatch.metaphone('Robert', 2);

--echo # metaphone NULL
SELECT vsql_fuzzystrmatch.metaphone(NULL, 10);

--echo # metaphone output longer than the server's actual initial result
--echo # buffer (the framework rounds buffer_size(64) up to a 1024-byte
--echo # allocation quantum, so the input must clear 1024 bytes of output
--echo # to exercise the overflow path): the server must grow the buffer
--echo # and retry so the full code comes back, not a truncated prefix.
SELECT LENGTH(vsql_fuzzystrmatch.metaphone('', 2000));
SELECT vsql_fuzzystrmatch.metaphone('', 2000);

--echo # metaphone materialized into a narrow result column (CREATE TABLE AS
--echo # SELECT) used to fail: with no .max_result_length() declared, the
--echo # server sized the materialized column from the STRING argument's own
--echo # width, not from what metaphone() can actually produce. Metaphone can
--echo # expand input (e.g. 'X' -> "KS"), so a short source column plus a
--echo # generous max_output_length produced a code wider than that fallback
--echo # width, and materializing it raised ER_DATA_TOO_LONG. A latin1 source
--echo # column is used because a utf8mb4 one's byte-width fallback happens to
--echo # carry enough cushion to mask the bug.
CREATE TABLE fz_src (s VARCHAR(10) CHARACTER SET latin1 NOT NULL);
INSERT INTO fz_src VALUES ('XBXBXBXBXB');
SELECT vsql_fuzzystrmatch.metaphone(s, 200),
       LENGTH(vsql_fuzzystrmatch.metaphone(s, 200))
  FROM fz_src;
CREATE TABLE fz_materialized AS
  SELECT vsql_fuzzystrmatch.metaphone(s, 200) AS m FROM fz_src;
SHOW CREATE TABLE fz_materialized;
SELECT m, LENGTH(m) FROM fz_materialized;
DROP TABLE fz_materialized, fz_src;

UNINSTALL EXTENSION vsql_fuzzystrmatch;
