INSTALL EXTENSION vsql_fuzzystrmatch;

--echo # metaphone basic
SELECT vsql_fuzzystrmatch.metaphone('Robert', 10);
SELECT vsql_fuzzystrmatch.metaphone('Thompson', 10);

--echo # metaphone truncation
SELECT vsql_fuzzystrmatch.metaphone('Robert', 2);

--echo # metaphone NULL
SELECT vsql_fuzzystrmatch.metaphone(NULL, 10);

--echo # metaphone output longer than the server's actual initial result
--echo # buffer (the framework rounds buffer_size(64) up to a 1024-byte
--echo # allocation quantum, so the input must clear 1024 bytes of output
--echo # to exercise the overflow path): the server must grow the buffer
--echo # and retry so the full code comes back, not a truncated prefix.
SELECT LENGTH(vsql_fuzzystrmatch.metaphone('', 2000));
SELECT vsql_fuzzystrmatch.metaphone('', 2000);

UNINSTALL EXTENSION vsql_fuzzystrmatch;
